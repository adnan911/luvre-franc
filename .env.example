# Server-only Druto credentials. Never rename with NEXT_PUBLIC_ or expose in client code.
DRUTO_API_KEY=druto_test_replace_me
DRUTO_WEBHOOK_SECRET=replace_after_registering_webhook
DRUTO_CHECKOUT_BASE_URL=https://your-druto-host.example
DRUTO_CREATE_INTENT_ENDPOINT=/api/trpc/payments.createIntent

# Public storefront configuration; safe to expose in the browser.
NEXT_PUBLIC_DRUTO_MARKETPLACE_ID=luvre-franc
NEXT_PUBLIC_DRUTO_SELLER_ID=luvre-main
NEXT_PUBLIC_DRUTO_DASHBOARD_URL=https://your-druto-host.example/dashboard
NEXT_PUBLIC_SHOP_URL=http://localhost:3000
